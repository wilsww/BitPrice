# Codex delegation intermediates (drafts, dispatch logs, verdicts).
# thread_ledger.txt lives here too but is regenerable; the durable record of
# review outcomes belongs in findings.md, not in this directory.
.codex-review/

# Codex implement-mode dispatch logs and run summaries. The durable record of
# what was delegated and verified belongs in task_plan.md and findings.md.
.codex-implement/

# Build output — the app bundle is assembled by scripts/build-app.sh
build/

# Incremental compile cache used by scripts/build-app.sh and run-tests.sh
.build-cache/

# macOS
.DS_Store

# Icon candidate contact sheets. Regenerable with scripts/preview-icon.swift;
# only the chosen design's reference render is tracked.
design/icon/candidates.png
